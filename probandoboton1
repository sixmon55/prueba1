from datetime import datetime, timedelta
from conexion import get_connection
from main import menu_inicio  # Importar el menú principal

def pantalla_arrepentimiento():
    while True:
        print("\n--- BOTÓN DE ARREPENTIMIENTO ---")
        print("Escriba 'salir' para volver al menú principal.\n")

        email = input("Ingrese el email del cliente para consultar sus ventas: ")
        if email.lower() == "salir":
            menu_inicio()
            return

        try:
            connection = get_connection()
            if not connection:
                print("No se pudo conectar a la base de datos.")
                continue

            cursor = connection.cursor()

            query = """
            SELECT v.id_venta, c.email, v.id_destino, he.fecha, ev.nombre 
            FROM VENTA v
            INNER JOIN CLIENTE c ON v.id_cliente = c.id_cliente
            INNER JOIN HISTORIAL_ESTADOVENTA he ON v.id_venta = he.id_venta
            INNER JOIN ESTADO_VENTA ev ON he.id_estado = ev.id_estado
            WHERE c.email = %s
            ORDER BY he.fecha DESC
            """
            cursor.execute(query, (email,))
            ventas = cursor.fetchall()

            if not ventas:
                print("No se encontraron ventas asociadas a este cliente.\n")
                continue

            ventas_dict = {}
            for v in ventas:
                id_venta = v[0]
                if id_venta not in ventas_dict:
                    ventas_dict[id_venta] = {
                        "email": v[1],
                        "id_destino": v[2],
                        "fecha_estado": v[3],
                        "estado": v[4]
                    }

            print("\nVentas encontradas:")
            for idx, (id_venta, datos) in enumerate(ventas_dict.items(), start=1):
                print(f"{idx}. ID Venta: {id_venta}, Destino ID: {datos['id_destino']}, Estado: {datos['estado']}, Fecha estado: {datos['fecha_estado']}")

            seleccion = input("\nSeleccione el número de la venta que desea revisar (o escriba 'salir' para volver): ")
            if seleccion.lower() == "salir":
                menu_inicio()
                return

            if not seleccion.isdigit() or int(seleccion) < 1 or int(seleccion) > len(ventas_dict):
                print("Selección inválida.\n")
                continue

            id_venta_seleccionada = list(ventas_dict.keys())[int(seleccion) - 1]
            venta_seleccionada = ventas_dict[id_venta_seleccionada]

            estado_actual = venta_seleccionada["estado"]
            fecha_estado = venta_seleccionada["fecha_estado"]

            if estado_actual.lower() == "pendiente":
                tiempo_actual = datetime.now()
                tiempo_estado = fecha_estado
                diferencia = tiempo_actual - tiempo_estado

                if diferencia <= timedelta(minutes=5):
                    print("\n¿Está usted seguro? Si continúa, su venta será cancelada.")
                    print("1 - Continuar con la cancelación")
                    print("2 - Cancelar y volver")

                    opcion = input("Ingrese una opción: ")

                    if opcion == "1":
                        update_query = """
                        INSERT INTO HISTORIAL_ESTADOVENTA (id_venta, id_estado, fecha)
                        VALUES (%s, %s, NOW())
                        """
                        cursor.execute(update_query, (id_venta_seleccionada, 3))
                        connection.commit()
                        print("La venta ha sido cancelada exitosamente.\n")
                    else:
                        print("Operación cancelada por el usuario.\n")
                else:
                    print("\nUsted ha sobrepasado el tiempo estipulado para cancelación/arrepentimiento.")
                    print("Por favor, comuníquese con la compañía para gestionar un cambio.")
                    print("0800-000000 Atención al cliente de SkyRoute, de Lunes a Viernes de 09 a 18 hs.\n")
            else:
                print(f"\nLa venta seleccionada no está en estado 'Pendiente' (estado actual: {estado_actual}).\n")

            input("Presione Enter para volver al menú principal...")
            menu_inicio()
            return

        except Exception as e:
            print(f"Ocurrió un error: {e}\n")
            input("Presione Enter para volver al menú principal...")
            menu_inicio()
            return
        finally:
            if connection:
                cursor.close()
                connection.close()

if __name__ == "__main__":
    pantalla_arrepentimiento()
